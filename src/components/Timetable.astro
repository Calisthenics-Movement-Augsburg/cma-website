---
import SectionBackground from './SectionBackground.astro';

interface TimetableSlot {
	title: string;
	time: string;
	trainer: string;
	description?: string;
	note?: string;
}

interface TimetableDay {
	dateLabel: string;
	weekday:
		| 'monday'
		| 'tuesday'
		| 'wednesday'
		| 'thursday'
		| 'friday'
		| 'saturday'
		| 'sunday';
	slots: TimetableSlot[];
}

interface TimetableContent {
	title: string;
	intro?: string;
	days: TimetableDay[];
	cta: {
		label: string;
		href: string;
	};
}

interface Props {
	content: TimetableContent;
	backgroundImage?: string;
}

const { content, backgroundImage } = Astro.props;
---

<section id="trainings-timetable" class="relative isolate overflow-hidden py-20 md:py-28">
	{
		backgroundImage && (
			<SectionBackground
				image={backgroundImage}
				overlayClass="bg-white/70 dark:bg-black/60"
			/>
		)
	}

	<div class="mx-auto w-full max-w-[1600px] px-4 text-gray-900 sm:px-6 lg:px-10 dark:text-white">
		<div class="mx-auto max-w-3xl text-center">
			<h2 class="text-4xl font-bold md:text-5xl">{content.title}</h2>
			<div class="mx-auto mt-4 h-1.5 w-28 bg-brand"></div>

			{
				content.intro && (
					<p class="mt-6 text-base leading-relaxed text-gray-700 md:text-lg dark:text-gray-200">
						{content.intro}
					</p>
				)
			}
		</div>

		<div class="mt-10">
			<div class="ml-timetable-cols">
				{
					content.days.map((day) => (
						<article class="ml-day-col">
							<header class="ml-day-header">
								<span class="ml-day-title" data-weekday={day.weekday}>
									{day.dateLabel}
								</span>
							</header>

							<div class="ml-day-slots">
								{day.slots.map((slot) => (
									<div class="ml-card">
										<div class="ml-card-title">{slot.title}</div>

										<div class="ml-meta-row">
											<span class="ml-meta-label">Uhrzeit</span>
											<strong>{slot.time}</strong>
										</div>

										<div class="ml-meta-row">
											<span class="ml-meta-label">Training</span>
											<strong>{slot.trainer}</strong>
										</div>

										{
											slot.description && (
												<p class="ml-card-description">{slot.description}</p>
											)
										}

										{
											slot.note && (
												<span class="ml-badge">
													{slot.note}
												</span>
											)
										}
									</div>
								))}
							</div>
						</article>
					))
				}
			</div>
		</div>

		<div class="mt-10 flex justify-center">
			<a
				class="inline-flex items-center rounded-full bg-brand px-8 py-3 text-sm font-bold uppercase tracking-wide transition hover:bg-brand-muted"
				href={content.cta.href}
			>
				{content.cta.label}
			</a>
		</div>
	</div>
</section>

<style>
	.ml-timetable-cols {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
	}

	.ml-day-col {
		width: 100%;
		max-width: 100%;
		background: rgba(255, 255, 255, 0.72);
		border: 1px solid rgba(17, 24, 39, 0.12);
		backdrop-filter: blur(6px);
		border-radius: 1rem;
		padding: 1rem;
	}

	.ml-day-header {
		padding-bottom: 0.75rem;
		border-bottom: 1px solid rgba(17, 24, 39, 0.15);
		margin-bottom: 0.75rem;
	}

	.ml-day-title {
		font-weight: 700;
	}

	.ml-today {
		color: var(--color-brand-muted);
	}

	.ml-day-slots {
		display: grid;
		gap: 0.75rem;
	}

	.ml-card {
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid rgba(17, 24, 39, 0.1);
		border-radius: 0.75rem;
		padding: 0.875rem;
	}

	.ml-card-title {
		font-size: 1.05rem;
		font-weight: 700;
		margin-bottom: 0.65rem;
	}

	.ml-meta-row {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.9rem;
		margin-top: 0.35rem;
	}

	.ml-meta-label {
		opacity: 0.72;
	}

	.ml-card-description {
		margin-top: 0.75rem;
		font-size: 0.92rem;
		line-height: 1.55;
		color: rgba(17, 24, 39, 0.82);
	}

	.ml-badge {
		display: inline-block;
		margin-top: 0.8rem;
		border-radius: 999px;
		background: rgba(36, 200, 0, 0.12);
		color: #15803d;
		padding: 0.3rem 0.65rem;
		font-size: 0.78rem;
		font-weight: 700;
	}

	:global(.dark) .ml-day-col {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.15);
	}

	:global(.dark) .ml-day-header {
		border-bottom-color: rgba(255, 255, 255, 0.18);
	}

	:global(.dark) .ml-card {
		background: rgba(0, 0, 0, 0.35);
		border-color: transparent;
	}

	:global(.dark) .ml-card-description {
		color: rgba(255, 255, 255, 0.78);
	}

	:global(.dark) .ml-badge {
		background: rgba(134, 239, 172, 0.12);
		color: #86efac;
	}

	@media (min-width: 800px) {
		.ml-day-col {
			width: calc((100% - 1rem) / 2);
			max-width: calc((100% - 1rem) / 2);
		}
	}

	@media (min-width: 1100px) {
		.ml-day-col {
			width: calc((100% - 3rem) / 4);
			max-width: calc((100% - 3rem) / 4);
		}
	}
</style>

<script>
	const todayFormatter = new Intl.DateTimeFormat('en-US', {
		weekday: 'long',
		timeZone: 'Europe/Berlin',
	});

	const today = todayFormatter.format(new Date()).toLowerCase();

	document.querySelectorAll<HTMLElement>('[data-weekday]').forEach((dayTitle) => {
		const isToday = dayTitle.dataset.weekday === today;

		dayTitle.classList.toggle('ml-today', isToday);

		if (isToday) {
			dayTitle.setAttribute('aria-current', 'date');
		} else {
			dayTitle.removeAttribute('aria-current');
		}
	});
</script>